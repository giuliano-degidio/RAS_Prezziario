{
  "name": "POC_FRONTIERA_ANAG_AREA_VASTA",
  "description": "Proof flow NiFi: TRUNCATE + query rasop + insert in hcbi frontiera_anag_area_vasta",
  "sourceQuery": "SELECT id::character varying(100) AS id, nome::character varying(100) AS nome FROM public.aree_vaste ORDER BY id;",
  "targetTable": "hcbi_ras.frontiera_anag_area_vasta",
